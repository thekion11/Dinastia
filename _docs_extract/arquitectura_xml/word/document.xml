<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:mo="http://schemas.microsoft.com/office/mac/office/2008/main" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mv="urn:schemas-microsoft-com:mac:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 wp14"><w:body><w:p><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t>Documento Técnico Maestro: Arquitectura, Depuración y Motor Táctico de Simulación</w:t></w:r></w:p><w:p><w:r><w:t>Proyecto: DE</w:t><w:br/><w:t>Motor: Godot 4.x</w:t><w:br/><w:t>Área: Capa Núcleo (Simulación Matemática) &amp; Capa Visor (Renderizado 3D y Cinemática Broadcast)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>1. Arquitectura de 3 Capas (Núcleo vs. Visor)</w:t></w:r></w:p><w:p><w:r><w:t>Para garantizar un juego fluido, libre de desincronizaciones y con acabado profesional, el sistema preserva la separación estricta de responsabilidades:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t>[ Capa 1: Núcleo Matemático ]  (nucleo/partido.gd)</w:t><w:br/><w:t xml:space="preserve">            │</w:t><w:br/><w:t xml:space="preserve">            ▼ (Emite diccionario determinista de eventos/ticks)</w:t><w:br/><w:t>[ Capa 2: Visor de Simulación ] (visor/MatchPlayback.gd)</w:t><w:br/><w:t xml:space="preserve">            │</w:t><w:br/><w:t xml:space="preserve">            ▼ (Interpola transformaciones 3D, IK, AnimationTree)</w:t><w:br/><w:t>[ Capa 3: Presentación Visual ] (ui/estadio.gd, stadium_builder.gd, Shaders, Audio)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>Contrato de Coordenadas y Escala Métrica (Norma FIFA / IFAB)</w:t></w:r></w:p><w:p><w:r><w:t>• Escala global: 1.0 unidad de Godot = 1.0 metro real.</w:t><w:br/><w:t>• Dimensiones Oficiales: Largo (X) = 105.0m, Ancho (Z) = 68.0m.</w:t><w:br/><w:t>• Origen de Coordenadas (0,0,0): Punto central del círculo del medio campo.</w:t><w:br/><w:t>• Límites en X: [-52.5m, +52.5m].</w:t><w:br/><w:t>• Límites en Z: [-34.0m, +34.0m].</w:t><w:br/><w:t>• Altura Y: 0.0m (ras de césped) a +2.44m (larguero).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>2. Correcciones Críticas del Visor (Soluciones en Godot 4)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>2.1. tele_dinamica.gd</w:t></w:r></w:p><w:p><w:r><w:t>Problema resuelto: La distorsión por vista ortográfica o perspectiva gran angular (que aplastaba la geometría y rompía la anatomía de los futbolistas).</w:t><w:br/><w:t>Solución: Teleobjetivo (FOV ≈ 20º - 22º)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://ui/tele_dinamica.gd</w:t><w:br/><w:t>class_name TeleDinamica</w:t><w:br/><w:t>extends Camera3D</w:t><w:br/><w:br/><w:t>@export var target_balon: Node3D</w:t><w:br/><w:t>@export var altura_base: float = 36.0</w:t><w:br/><w:t>@export var distancia_z_base: float = 46.0</w:t><w:br/><w:t>@export var fov_transmision: float = 21.0</w:t><w:br/><w:br/><w:t># Amortiguación</w:t><w:br/><w:t>var _pos_objetivo: Vector3 = Vector3.ZERO</w:t><w:br/><w:t>var _foco_actual: Vector3 = Vector3.ZERO</w:t><w:br/><w:t>var _velocidad_amortiguacion: Vector3 = Vector3.ZERO</w:t><w:br/><w:br/><w:t>func _ready() -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    projection = Camera3D.PROJECTION_PERSPECTIVE</w:t><w:br/><w:t xml:space="preserve">    fov = fov_transmision</w:t><w:br/><w:t xml:space="preserve">    near = 1.0</w:t><w:br/><w:t xml:space="preserve">    far = 400.0</w:t><w:br/><w:br/><w:t>func _process(delta: float) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    if not target_balon:</w:t><w:br/><w:t xml:space="preserve">        return</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    var pos_b = target_balon.global_position</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    # Mapeo no lineal: la cámara sigue la jugada sin salir del perímetro</w:t><w:br/><w:t xml:space="preserve">    var cam_x = clampf(pos_b.x * 0.72, -36.0, 36.0)</w:t><w:br/><w:t xml:space="preserve">    var cam_z = (pos_b.z * 0.28) + distancia_z_base</w:t><w:br/><w:t xml:space="preserve">    var cam_y = altura_base + (abs(pos_b.x) * 0.05)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    _pos_objetivo = Vector3(cam_x, cam_y, cam_z)</w:t><w:br/><w:t xml:space="preserve">    global_position = global_position.lerp(_pos_objetivo, delta * 3.8)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    var foco_deseado = Vector3(pos_b.x * 0.85, 0.4, pos_b.z * 0.65)</w:t><w:br/><w:t xml:space="preserve">    _foco_actual = _foco_actual.lerp(foco_deseado, delta * 5.0)</w:t><w:br/><w:t xml:space="preserve">    look_at(_foco_actual, Vector3.UP)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>2.2. Locomoción sin Deslizamiento de Pies</w:t></w:r></w:p><w:p><w:r><w:t>Archivo: res://visor/jugador_visor.gd</w:t><w:br/><w:t>Lógica: El Árbol de animación no se activa con estados binarios (correr/parar). Se calcula la velocidad lineal instantánea derivada de la inercia.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://visor/jugador_visor.gd</w:t><w:br/><w:t>class_name JugadorVisor</w:t><w:br/><w:t>extends CharacterBody3D</w:t><w:br/><w:br/><w:t xml:space="preserve">@export var velocidad_base_anim_carrera: float = 4.6 </w:t><w:br/><w:t>@onready var anim_tree: AnimationTree = $AnimationTree</w:t><w:br/><w:br/><w:t>var _posicion_anterior: Vector3 = Vector3.ZERO</w:t><w:br/><w:t>var _velocidad_escalar_m_s: float = 0.0</w:t><w:br/><w:br/><w:t>func _ready() -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    _posicion_anterior = global_position</w:t><w:br/><w:br/><w:t>func actualizar_locomocion_tick(delta: float, destino_tactico: Vector3, factor_inercia: float) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    var pos_previa = global_position</w:t><w:br/><w:t xml:space="preserve">    global_position = global_position.lerp(destino_tactico, factor_inercia * delta)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    var desplazamiento = (global_position - pos_previa)</w:t><w:br/><w:t xml:space="preserve">    desplazamiento.y = 0.0</w:t><w:br/><w:t xml:space="preserve">    _velocidad_escalar_m_s = desplazamiento.length() / maxf(delta, 0.0001)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    if _velocidad_escalar_m_s &gt; 0.35:</w:t><w:br/><w:t xml:space="preserve">        var dir = desplazamiento.normalized()</w:t><w:br/><w:t xml:space="preserve">        var angulo_rad = atan2(-dir.x, -dir.z)</w:t><w:br/><w:t xml:space="preserve">        rotation.y = lerp_angle(rotation.y, angulo_rad, 12.0 * delta)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    _sincronizar_animacion()</w:t><w:br/><w:br/><w:t>func _sincronizar_animacion() -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    var blend: float = clampf(_velocidad_escalar_m_s / 6.5, 0.0, 1.0)</w:t><w:br/><w:t xml:space="preserve">    anim_tree.set("parameters/Locomocion/blend_position", blend)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    if _velocidad_escalar_m_s &gt; 0.2:</w:t><w:br/><w:t xml:space="preserve">        var escala_tiempo = _velocidad_escalar_m_s / velocidad_base_anim_carrera</w:t><w:br/><w:t xml:space="preserve">        anim_tree.set("parameters/TimeScale/scale", clampf(escala_tiempo, 0.6, 1.4))</w:t><w:br/><w:t xml:space="preserve">    else:</w:t><w:br/><w:t xml:space="preserve">        anim_tree.set("parameters/TimeScale/scale", 1.0)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>2.3. Saneamiento del Modelo Fantasma ("El Gigante")</w:t></w:r></w:p><w:p><w:r><w:t>Archivo: res://escenas/estadio.gd</w:t><w:br/><w:t>Lógica: Limpieza recursiva en _ready() para eliminar maniquíes o mallas residuales instanciadas accidentalmente en (0, 0, 0).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://escenas/estadio.gd</w:t><w:br/><w:t>extends Node3D</w:t><w:br/><w:br/><w:t>func _ready() -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    purgar_nodos_fantasma()</w:t><w:br/><w:br/><w:t>func purgar_nodos_fantasma() -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    for nodo in get_children():</w:t><w:br/><w:t xml:space="preserve">        if nodo is CharacterBody3D and not nodo.is_in_group("jugadores_activos"):</w:t><w:br/><w:t xml:space="preserve">            push_warning("[LIMPIEZA] Eliminado nodo fantasma residual: %s" % nodo.name)</w:t><w:br/><w:t xml:space="preserve">            nodo.queue_free()</w:t><w:br/><w:t xml:space="preserve">        elif nodo is MeshInstance3D and nodo.name.to_lower().contains("dummy"):</w:t><w:br/><w:t xml:space="preserve">            nodo.queue_free()</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>2.4. Banquillos y Entorno Procedural Proporcional</w:t></w:r></w:p><w:p><w:r><w:t>Archivo: res://generadores/stadium_builder.gd</w:t><w:br/><w:t>Lógica: Cálculo estricto del AABB para forzar escala reglamentaria (2.2m de alto) y ubicación 3.5m tras la línea de banda.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://generadores/stadium_builder.gd</w:t><w:br/><w:t>class_name StadiumBuilder</w:t><w:br/><w:t>extends Node</w:t><w:br/><w:br/><w:t>const ANCHO_CANCHA: float = 68.0</w:t><w:br/><w:t>const DISTANCIA_LINEA_BANDA: float = 3.5</w:t><w:br/><w:br/><w:t>static func configurar_banquillo(instancia: Node3D, es_local: bool) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    var aabb = _obtener_aabb_recursivo(instancia)</w:t><w:br/><w:t xml:space="preserve">    if aabb.size.y &gt; 0.001:</w:t><w:br/><w:t xml:space="preserve">        var factor_escala = 2.2 / aabb.size.y</w:t><w:br/><w:t xml:space="preserve">        instancia.scale = Vector3.ONE * factor_escala</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    var offset_x = -14.0 if es_local else 14.0</w:t><w:br/><w:t xml:space="preserve">    var pos_z = (ANCHO_CANCHA * 0.5) + DISTANCIA_LINEA_BANDA</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    instancia.global_position = Vector3(offset_x, 0.0, pos_z)</w:t><w:br/><w:t xml:space="preserve">    instancia.rotation_degrees.y = 180.0</w:t><w:br/><w:br/><w:t>static func _obtener_aabb_recursivo(nodo: Node3D) -&gt; AABB:</w:t><w:br/><w:t xml:space="preserve">    var box = AABB()</w:t><w:br/><w:t xml:space="preserve">    var primero = true</w:t><w:br/><w:t xml:space="preserve">    for hijo in nodo.find_children("*", "MeshInstance3D"):</w:t><w:br/><w:t xml:space="preserve">        var mesh_inst = hijo as MeshInstance3D</w:t><w:br/><w:t xml:space="preserve">        if mesh_inst and mesh_inst.mesh:</w:t><w:br/><w:t xml:space="preserve">            var sub_aabb = mesh_inst.mesh.get_aabb()</w:t><w:br/><w:t xml:space="preserve">            if primero:</w:t><w:br/><w:t xml:space="preserve">                box = sub_aabb</w:t><w:br/><w:t xml:space="preserve">                primero = false</w:t><w:br/><w:t xml:space="preserve">            else:</w:t><w:br/><w:t xml:space="preserve">                box = box.merge(sub_aabb)</w:t><w:br/><w:t xml:space="preserve">    return box</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>3. Motor Físico Balístico del Balón</w:t></w:r></w:p><w:p><w:r><w:t>Archivo: res://nucleo/balon_fisica.gd</w:t><w:br/><w:t>Modela trayectorias curvas (efecto Magnus), amortiguación de bote sobre césped y sustentación aérea.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://nucleo/balon_fisica.gd</w:t><w:br/><w:t>class_name BalonFisica</w:t><w:br/><w:t>extends Node3D</w:t><w:br/><w:br/><w:t>const GRAVEDAD: float = 9.81</w:t><w:br/><w:t>const RESISTENCIA_AIRE: float = 0.12</w:t><w:br/><w:t>const RESTITUCION_CESPED: float = 0.58</w:t><w:br/><w:br/><w:t>var velocidad_vectorial: Vector3 = Vector3.ZERO</w:t><w:br/><w:t>var giro_angular: Vector3 = Vector3.ZERO</w:t><w:br/><w:br/><w:t>func disparar(impulso: Vector3, spin: Vector3) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    velocidad_vectorial = impulso</w:t><w:br/><w:t xml:space="preserve">    giro_angular = spin</w:t><w:br/><w:br/><w:t>func actualizar_fisica(delta: float) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    var fuerza_magnus = giro_angular.cross(velocidad_vectorial) * 0.02</w:t><w:br/><w:t xml:space="preserve">    var arrastre = -velocidad_vectorial * RESISTENCIA_AIRE</w:t><w:br/><w:t xml:space="preserve">    var aceleracion = Vector3(0, -GRAVEDAD, 0) + fuerza_magnus + arrastre</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    velocidad_vectorial += aceleracion * delta</w:t><w:br/><w:t xml:space="preserve">    global_position += velocidad_vectorial * delta</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    if global_position.y &lt;= 0.11: </w:t><w:br/><w:t xml:space="preserve">        global_position.y = 0.11</w:t><w:br/><w:t xml:space="preserve">        velocidad_vectorial.y = -velocidad_vectorial.y * RESTITUCION_CESPED</w:t><w:br/><w:t xml:space="preserve">        velocidad_vectorial.x *= 0.82</w:t><w:br/><w:t xml:space="preserve">        velocidad_vectorial.z *= 0.82</w:t><w:br/><w:t xml:space="preserve">        giro_angular *= 0.7</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>4. Catálogo Maestro de Jugadas Tácticas Prehechas</w:t></w:r></w:p><w:p><w:r><w:t>Cada jugada se define como un arreglo ordenado de fases cinemáticas que el núcleo evalúa matemáticamente y despacha al MatchPlayback para su renderizado. Se incluyen catalogadas 15 de ataque, 15 de defensa, 15 de portero y 15 de faltas/fueras de juego detalladas en el documento base.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>5. Implementación del Gestor de Jugadas</w:t></w:r></w:p><w:p><w:r><w:t>Archivo: res://visor/reproductor_jugadas.gd</w:t><w:br/><w:t>Este script consume la definición de las 60 jugadas generadas en el núcleo, maneja las fases de interpolación y orquesta tanto la cinemática del balón como las órdenes de cámara.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://visor/reproductor_jugadas.gd</w:t><w:br/><w:t>class_name ReproductorJugadas</w:t><w:br/><w:t>extends Node</w:t><w:br/><w:br/><w:t>signal jugada_iniciada(codigo_jugada: String)</w:t><w:br/><w:t>signal jugada_completada(resultado: Dictionary)</w:t><w:br/><w:br/><w:t>@export var camara_ref: TeleDinamica</w:t><w:br/><w:t>@export var balon_ref: BalonFisica</w:t><w:br/><w:br/><w:t>var _en_reproduccion: bool = false</w:t><w:br/><w:t>var _tiempo_fase: float = 0.0</w:t><w:br/><w:t>var _fase_actual: int = 0</w:t><w:br/><w:t>var _datos_jugada: Dictionary = {}</w:t><w:br/><w:br/><w:t>func ejecutar_jugada_prehecha(codigo_jugada: String, datos_actores: Dictionary) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    _datos_jugada = CatalogoJugadas.obtener_definicion(codigo_jugada)</w:t><w:br/><w:t xml:space="preserve">    if _datos_jugada.is_empty():</w:t><w:br/><w:t xml:space="preserve">        push_error("Jugada no catalogada: " + codigo_jugada)</w:t><w:br/><w:t xml:space="preserve">        return</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    _fase_actual = 0</w:t><w:br/><w:t xml:space="preserve">    _tiempo_fase = 0.0</w:t><w:br/><w:t xml:space="preserve">    _en_reproduccion = true</w:t><w:br/><w:t xml:space="preserve">    emit_signal("jugada_iniciada", codigo_jugada)</w:t><w:br/><w:br/><w:t>func _process(delta: float) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    if not _en_reproduccion: return</w:t><w:br/><w:t xml:space="preserve">        </w:t><w:br/><w:t xml:space="preserve">    _tiempo_fase += delta</w:t><w:br/><w:t xml:space="preserve">    var fases: Array = _datos_jugada.get("fases", [])</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    if _fase_actual &gt;= fases.size():</w:t><w:br/><w:t xml:space="preserve">        _finalizar_jugada()</w:t><w:br/><w:t xml:space="preserve">        return</w:t><w:br/><w:t xml:space="preserve">        </w:t><w:br/><w:t xml:space="preserve">    var fase_data: Dictionary = fases[_fase_actual]</w:t><w:br/><w:t xml:space="preserve">    var duracion_fase: float = fase_data.get("duracion", 1.0)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    _procesar_fase(fase_data, delta)</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    if _tiempo_fase &gt;= duracion_fase:</w:t><w:br/><w:t xml:space="preserve">        _tiempo_fase = 0.0</w:t><w:br/><w:t xml:space="preserve">        _fase_actual += 1</w:t><w:br/><w:br/><w:t>func _procesar_fase(fase: Dictionary, delta: float) -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    if fase.has("impulso_balon"):</w:t><w:br/><w:t xml:space="preserve">        var impulso = fase["impulso_balon"]</w:t><w:br/><w:t xml:space="preserve">        var spin = fase.get("spin_balon", Vector3.ZERO)</w:t><w:br/><w:t xml:space="preserve">        balon_ref.disparar(impulso, spin)</w:t><w:br/><w:t xml:space="preserve">        fase.erase("impulso_balon")</w:t><w:br/><w:t xml:space="preserve">    </w:t><w:br/><w:t xml:space="preserve">    var es_peligro = fase.get("es_peligro", false)</w:t><w:br/><w:t xml:space="preserve">    # camara_ref.actualizar_camara(delta, es_peligro) </w:t><w:br/><w:br/><w:t>func _finalizar_jugada() -&gt; void:</w:t><w:br/><w:t xml:space="preserve">    _en_reproduccion = false</w:t><w:br/><w:t xml:space="preserve">    emit_signal("jugada_completada", {"exito": true, "jugada": _datos_jugada.get("codigo", "")})</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>6. Base de Datos de Jugadas (nucleo/catalogo_jugadas.gd)</w:t></w:r></w:p><w:p><w:r><w:t>Estructura de datos centralizada que alimenta tanto la simulación como la reproducción:</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="240"/><w:ind w:left="432"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Consolas" w:hAnsi="Consolas"/><w:color w:val="2B91AF"/><w:sz w:val="18"/></w:rPr><w:t># res://nucleo/catalogo_jugadas.gd</w:t><w:br/><w:t>class_name CatalogoJugadas</w:t><w:br/><w:t>extends RefCounted</w:t><w:br/><w:br/><w:t>static func obtener_definicion(id: String) -&gt; Dictionary:</w:t><w:br/><w:t xml:space="preserve">    match id:</w:t><w:br/><w:t xml:space="preserve">        "ATQ-01":</w:t><w:br/><w:t xml:space="preserve">            return {</w:t><w:br/><w:t xml:space="preserve">                "codigo": "ATQ-01",</w:t><w:br/><w:t xml:space="preserve">                "nombre": "Cutback por Banda",</w:t><w:br/><w:t xml:space="preserve">                "fases": [</w:t><w:br/><w:t xml:space="preserve">                    {"duracion": 1.4, "es_peligro": false, "impulso_balon": Vector3(18.0, 0.0, -12.0)},</w:t><w:br/><w:t xml:space="preserve">                    {"duracion": 0.8, "es_peligro": true, "impulso_balon": Vector3(-8.0, 0.0, 10.0)},</w:t><w:br/><w:t xml:space="preserve">                    {"duracion": 0.6, "es_peligro": true, "impulso_balon": Vector3(28.0, 4.2, 0.0), "spin_balon": Vector3(0.0, 15.0, 0.0)}</w:t><w:br/><w:t xml:space="preserve">                ]</w:t><w:br/><w:t xml:space="preserve">            }</w:t><w:br/><w:t xml:space="preserve">        _:</w:t><w:br/><w:t xml:space="preserve">            return {}</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t>7. Instrucciones de Integración en el Proyecto</w:t></w:r></w:p><w:p><w:r><w:t>• Cámara: Asigna el script tele_dinamica.gd a la Cámara 3D principal. Vincula el nodo de tu balón.</w:t><w:br/><w:t>• Animaciones: Asegúrate de que el Árbol de animación use un nodo de tipo TimeScale.</w:t><w:br/><w:t>• Escala: Verificar que el campo mida exactamente 105x68 metros.</w:t><w:br/><w:t>• Banquillos: Invocar StadiumBuilder.configurar_banquillo().</w:t></w:r></w:p><w:sectPr w:rsidR="00FC693F" w:rsidRPr="0006063C" w:rsidSect="00034616"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1800" w:bottom="1440" w:left="1800" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>