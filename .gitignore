# Herramientas de terceros (se re-descargan de sus sitios oficiales, no son código propio)
herramientas/android/
herramientas/ffmpeg/
herramientas/godot/
herramientas/rclone/
herramientas/salida/

# Backups manuales de snapshots completos del proyecto (git reemplaza esta función hacia adelante)
respaldos/

# Carpeta con un clon git propio ya existente (usamos su remoto, no su contenido anidado)
/Dinastia/

# Basura habitual de SO / editores
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# Contrasenas de exportacion (keystore Android). Plantilla: dinastia-godot/export_credentials.cfg.ejemplo
dinastia-godot/export_credentials.cfg
dinastia-godot/pruebas/capturas/promo/
dinastia-godot/pruebas/capturas/lotes/

# Copias de trabajo de agentes de Claude Code
.claude/worktrees/

# Builds: salen de herramientas/empaquetar.ps1 y los maneja el dueño; no van al repo (23-10)
entregas/

# Capturas de pruebas: se regeneran con las escenas captura_*; las que citan los documentos siguen en git (23-10)
dinastia-godot/pruebas/capturas/*
!dinastia-godot/pruebas/capturas/.gdignore

# Godot importa AUDITORIA_CLUBES.csv como traducciones al correr el banco: derivados, no fuente.
dinastia-godot/AUDITORIA_CLUBES.*.translation
dinastia-godot/AUDITORIA_CLUBES.csv.import

# Paquete PRIVADO de caras y datos reales (herramientas/empaquetar_caras.gd): nunca al repositorio.
caras_reales.pck
