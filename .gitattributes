# Auto detect text files and perform LF normalization
* text=auto

# Git LFS: archivos binarios pesados típicos de un proyecto de juego/multimedia
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wem filter=lfs diff=lfs merge=lfs -text
*.pck filter=lfs diff=lfs merge=lfs -text

# El escaneo de la persona realista va como archivo normal (25 MB): desde las
# sesiones en la nube no se puede subir a LFS.
dinastia-godot/assets/personas/*.glb -filter -diff -merge binary
# Los peinados de los jugadores (glTF de texto + .bin chicos, <1 MB en total): archivos normales.
dinastia-godot/assets/characters/quaternius/pelo/*.gltf -filter -diff -merge
# Los edificios del kit comercial de Kenney que faltaban (CC0, ~2 MB): archivos normales.
dinastia-godot/assets/ciudad/kenney_comercial_extra/*.glb -filter -diff -merge binary
# El resto del Car Kit de Kenney (CC0): archivos normales.
dinastia-godot/assets/ciudad/kenney_cars_extra/*.glb -filter -diff -merge binary
dinastia-godot/assets/objetos/*.glb -filter -diff -merge binary
# City Kit Roads de Kenney (CC0, 1,7 MB): archivos normales. GUARDADO PARA DESPUÉS (14-10-2026, regalo del usuario); aún sin usar.
dinastia-godot/assets/ciudad/kenney_roads/*.glb -filter -diff -merge binary
# 10 kits 3D de Kenney (CC0, ~30 MB): archivos normales. GUARDADOS PARA DESPUÉS (15-10-2026, regalo del usuario); aún sin usar. Ver assets/kenney/INVENTARIO.md.
dinastia-godot/assets/kenney/muebles/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/edificios_modulares/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/mini_arcade/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/comida/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/kit_edificios/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/montana_rusa/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/tren/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/suburbano/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/mini_mercado/*.glb -filter -diff -merge binary
dinastia-godot/assets/kenney/industrial/*.glb -filter -diff -merge binary

# Muebles de Quaternius (CC0), regalo del usuario el 15-10-2026: archivos normales.
dinastia-godot/assets/quaternius_muebles/*.glb -filter -diff -merge binary

# Sonidos de interfaz pequeños (26-10): fuera de LFS, el contenedor no puede subir a LFS
dinastia-godot/audio/ui/*.ogg -filter -diff -merge binary
# Edificios de KayKit City Builder Bits (CC0, ~430 KB, 26-10): archivos normales; sustituyen a complejo_residencial.glb.
dinastia-godot/assets/ciudad/kaykit/*.gltf -filter -diff -merge
# Trofeo del museo del club (regalo del dueño, 27-10; una copa, 52 KB): archivo normal.
dinastia-godot/assets/ciudad/trofeo.glb -filter -diff -merge binary
# Máquina de peluches del centro comercial (regalo del dueño, 27-10; re-exportada con Godot, texturas 256 px, <1 MB): archivo normal.
dinastia-godot/assets/ciudad/maquina_peluches.glb -filter -diff -merge binary
# Los 15 peluches y la máquina de garra («Claw Machine Free», regalo del dueño en el Drive, 27-10-2026; texturas reducidas a 512 px, 1,6 MB): archivos normales.
dinastia-godot/assets/peluches/*.glb -filter -diff -merge binary
# El trofeo base del dueño (gold+trophy.glb del Drive, 3 copas de ~700 caras, 157 KB, 27-10-2026): archivo normal. Los trofeos de cada club salen de él.
dinastia-godot/assets/trofeos/*.glb -filter -diff -merge binary
# Las dos matas de hierba silvestre del grass.blend del dueño (Drive, 27-10-2026; texturas a 512 px, 590 KB): archivos normales.
dinastia-godot/assets/pasto/*.glb -filter -diff -merge binary
# Regalos del dueño del Drive optimizados (27-10-2026): torre de focos del estadio (11 k caras, texturas 512 px, 2,4 MB) y sillón de oficina (reducido de 118 k a 4,7 k caras, 314 KB): archivos normales.
dinastia-godot/assets/regalos/*.glb -filter -diff -merge binary
