+
+func _aporte(j: Jugador, v: float) -> void:
+	if j != null:
+		_aportes[j.id] = float(_aportes.get(j.id, 0.0)) + v
+
+func _aporte_gol(_c: Club, _autor: Jugador, _m: int, asis: Jugador) -> void:
