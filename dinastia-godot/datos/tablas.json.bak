,"Técnico de oficio","Los clubes te llaman antes de mirar a nadie más."],[1800,"Maestro","Tus equipos se reconocen a la primera."],[3200,"Leyenda","Ya no diriges clubes: diriges épocas."],[5500,"Dinastía","Tu apellido es una manera de entender el fútbol."]],"NOMBRES":["Matías","Benjamín","Vicente","Joaquín","Martín","Agustín","Tomás","Cristóbal","Sebastián","Diego","Felipe","Ignacio","Nicolás","Javier","Gonzalo","Rodrigo","Pablo","Andrés","Camilo","Esteban","Mauricio","Marcelo","Claudio","Fabián","Luis","Carlos","Jorge","Héctor","Iván","Óscar","Raúl","Hugo","Franco","Bruno","Lucas","Thiago","Gabriel","Emilio","Renato","Damián","Álvaro","Enzo","Bastián","Maximiliano","Alonso","Julián","Facundo","Ramiro","Santiago","Mateo","Axel","Kevin","Brayan","Yerko","Patricio","Rafael","Simón","Elías","Ángel","Dante"],"NOMBRES_BRA":["Thiago","Matheus","Gabriel","Lucas","João","Pedro","Rafael","Bruno","Felipe","Gustavo","Vinícius","Caio","Renan","Éverton","Wesley","Igor"],"NOMBRES_EXT":["Juan","Enzo","Lautaro","Nahuel","Ezequiel","Gastón","Leandro","Hernán","Walter","Marcos","Paulo","Caio","Wesley","Éder","Alan","Christian","Jefferson","Miguel","Édinson","Brayan","Yeferson","Teófilo","Duván","Jhon","Wilson"],"N_LEYENDAS_SEMILLA":44,"ORIGENES":[["potrero","🧱","del potrero","Se hizo en un baldío con arcos de piedra, sin árbitro y jugando contra grandes.",{"reg":3,"fis":2},"garra",22],["academia","🎓","de academia","Entró a los seis años a una escuela de élite. Sabe más de fútbol que de cualquier otra cosa.",{"pas":3,"tir":1},"tecnica",20],["pueblo","🌄","de pueblo chico","Viajaba tres horas en micro para cada entrenamiento. No conoce el cansancio.",{"fis":4},"garra",14],["futsal","🥅","del futsal","Viene de la cancha chica: piensa rápido y resuelve en dos metros cuadrados.",{"pas":2,"reg":2},"tecnica",11],["hermano","👨‍👦","a la sombra de un hermano","Creció compitiendo con un hermano mayor que llegó más lejos. Eso deja marca.",{"def":2,"fis":2},"garra",9],["tardio","⏳","de aparición tardía","Empezó a jugar en serio a los quince. Le sobra techo por descubrir.",{"rit":2},null,7],["fabrica","🏭","del turno de noche","Trabajaba de madrugada y entrenaba de día. Nadie le regaló un minuto.",{"fis":3,"def":1},"garra",6],["heredero","👔","de casa acomodada","Nunca le faltó nada. Hay quien duda de si tiene hambre suficiente.",{"tir":2,"pas":2},null,5],["playa","🏖️","del fútbol playa","Aprendió descalzo en la arena. Tiene un control que no se enseña en ninguna pizarra.",{"reg":4},"tecnica",4],["refugiado","🧳","refugiado","Llegó al país con lo puesto siendo un niño. El fútbol fue lo primero que lo hizo sentirse de algún lado.",{"fis":2,"rit":2},"garra",2]],"ORIG_PESO":100,"PAISES_EXT":["ARG","ARG","ARG","URU","PAR","BRA","COL","ECU","PER","VEN","BOL"],"PAISES_LIGAS":{"ARG":{"liga":"Liga Argentina","clubes":[["B0ca Juni0rs","#003f8a","#ffd100",90,54000],["R1ver Plate","#ffffff","#d50032",90,72000],["Rac1ng Club","#75aadb","#ffffff",82,55000],["San L0renzo","#00246b","#d50032",80,47000],["Ind3pendiente","#d50032","#ffffff",81,48000],["Estud1antes","#d50032","#ffffff",80,30000],["Vél3z","#ffffff","#00246b",79,49000],["Hurac4n","#ffffff","#d50032",75,48000],["R0sario Central","#003f8a","#ffd100",78,46000],["New3ll's","#d50032","#000000",77,42000],["Lanú5","#7a1f2b","#ffffff",76,47000],["Taller3s","#00246b","#ffffff",78,57000],["Banf1eld","#00843d","#ffffff",72,34000],["G0doy Cruz","#00246b","#ffffff",73,42000],["C0lón","#d50032","#000000",71,40000],["Un1ón SF","#d50032","#ffffff",71,26000]]},"BRA":{"liga":"Brasileirão","clubes":[["Flam3ngo","#d50032","#000000",91,74000],["Palme1ras","#006437","#ffffff",90,43000],["Sa0 Paulo","#ffffff","#d50032",86,66000],["Gr3mio","#0d80bf","#000000",84,55000],["C0rinthians","#000000","#ffffff",86,49000],["Sant0s","#ffffff","#000000",81,16000],["Flum1nense","#7a1f2b","#00843d",83,78000],["B0tafogo","#000000","#ffffff",82,44000],["Cruze1ro","#0038a8","#ffffff",81,62000],["Atl. M1neiro","#000000","#ffffff",83,46000],["Internaci0nal"