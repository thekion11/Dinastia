","Cruz central"],["liso","Liso"],["abanico","Abanico"],["rombos","Rombos"],["mitades","Dos mitades"]],"EST_CLIMAS":[["dia","☀️ Mediodía","#7fb6d9","#cfe4ef",0],["tarde","🌇 Atardecer","#e08a4a","#f6cf9a",0.35],["noche","🌙 Noche","#0a1420","#132436",1],["lluvia","🌧️ Lluvia","#3f4d57","#66757f",0.6],["nieve","❄️ Nieve","#8a97a3","#d7e2ea",0.35],["niebla","🌫️ Niebla","#6e7a78","#9fa9a6",0.45],["tormenta","⛈️ Tormenta","#232c36","#3c4b58",0.9]],"EST_CORNER":[["clasico","Banderín clásico","Palo blanco de 1,5 m con el banderín del club."],["alto","Palo alto","Un poste largo que se dobla con el viento."],["doble","Doble banderín","Dos telas superpuestas, la del club y la de la ciudad."],["led","Base LED","El pie se ilumina con los colores del club."],["sin","Sin banderines","Prohibido por la federación tras aquel incidente."]],"EST_DEF":{"forma":"cuenco","niveles":3,"techo":"anillo","pista":false,"asientoP":"franjas","asiento1":"","asiento2":"","asiento3":"#20272a","mosaico":"","cesped":"rayas","cespedTono":"vivo","lineaCol":"#ffffff","arcoCol":"#ffffff","redCol":"#ffffff","redTipo":"cuadrada","corner":"clasico","pantalla":"dos","camara":"dron","banquillo":"cristal","tunel":"central","focos":"torres","clima":"noche","banderas":"club","escudoDonde":"cancha","sonidoGol":"bombo","humo":true,"pirotecnia":true,"publico":"real","velOrb":"normal","vida":true,"vallas":true,"detalle":"medio","nombreFachada":true},"EST_ESCENAS":[["riego","💧 Riego automático","Los aspersores se levantan y barren el campo de lado a lado.",26],["corte","🚜 Corte del césped","El tractorcito va y viene dejando las franjas nuevas.",30],["entreno","🏃 Entrenamiento","El plantel sale a calentar: rondos, carrera suave y tiros al arco.",34],["camaras","🎥 Prueba de cámaras","El equipo de televisión barre el estadio comprobando los planos.",22],["limpieza","🧹 Limpieza de la grada","Las cuadrillas suben fila por fila recogiendo lo de anoche.",28],["pintura","🎨 Repintado de líneas","Marcan la cal otra vez antes del