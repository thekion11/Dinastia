-4":{"s":[["POR",50,94],["LD",84,74],["DFC",62,79],["DFC",38,79],["LI",16,74],["MC",60,56],["MC",40,56],["ED",82,26],["DC",60,18],["DC",40,18],["EI",18,26]],"DEF":4,"MED":2,"DEL":4},"3-4-1-2":{"s":[["POR",50,94],["DFC",72,79],["DFC",50,82],["DFC",28,79],["CAD",88,54],["MC",60,57],["MC",40,57],["CAI",12,54],["MCO",50,36],["DC",60,19],["DC",40,19]],"DEF":5,"MED":3,"DEL":2}},"GENTE_ROLES":[["utilero","Utilero","🧺","Lleva 30 años lavando camisetas y ha visto pasar a todos."],["jardinero","Jefe de cancha","🌱","El césped es suyo; los partidos son un mal necesario."],["cocinera","Cocinera del plantel","🍲","Sabe quién come bien y quién llega con olor a asado."],["conserje","Conserje del estadio","🔑","Abre y cierra. Se entera de todo porque nadie lo mira."],["secretaria","Secretaria del club","📋","Contratos, permisos y llamadas del presidente."],["chofer","Chofer del bus","🚌","Conduce en silencio y escucha absolutamente todo."],["medico","Médico veterano","🩺","Lleva más tiempo que el edificio y no se muerde la lengua."],["hincha","Viejo de la puerta 7","📣","No trabaja aquí, pero está aquí desde antes que tú."],["prensa","Encargado de prensa","🎙️","Le toca apagar los incendios que enciendes en rueda."],["ojeador","Ojeador jubilado","👓","Ya no cobra, pero sigue yendo a ver a los cabros."]],"GLOBO_FS":"\nprecision highp float;\nvarying vec2 vPos;\nuniform sampler2D uTex;     // día: Blue Marble con batimetría\nuniform sampler2D uNoche;   // noche: luces de ciudad VIIRS (Black Marble)\nuniform sampler2D uNubes;   // nubosidad real, en escala de grises\nuniform float uLon, uLat, uAspect, uNubOff;\nconst float PI=3.14159265359;\nvoid main(){\n  /* Coordenadas dentro del disco: el aspecto corrige que el canvas no sea cuadrado,\n     porque si no la Tierra saldría con forma de huevo. */\n  vec2 d=vec2(vPos.x*uAspect, vPos.y)/0.87;\n  float r2=dot(d,d);\n  if(r2>1.0){\n    /* Fuera de la esfera: halo de atmósfera que se apaga rápido. */\n    float rr=sqrt(r2);\n    float a=rr<1.18 ? pow(1.0-(rr-1.0)/0.18,2.0)*0.5 : 0.0;\n    if(a<=0.001) discard;\n    gl_FragColor=vec4(0.35,0.59,0.88,a);\n    return;\n  }\n  float dz=sqrt(1.0-r2);\n  float cx=cos(uLat), sx=sin(uLat), cy=cos(uLon), sy=sin(uLon);\n  /* Inversa de gl3(): se deshace primero el giro de latitud y luego el de longitud. */\n  float y1= d.y*cx + dz*sx;\n  float z1=-d.y*sx + dz*cx;\n  float x2= d.x*cy + z1*sy;\n  float z2=-d.x*sy + z1*cy;\n  float lat=asin(clamp(y1,-1.0,1.0));\n  float lon=atan(x2,z2);\n  vec2 uv=vec2(lon/(2.0*PI)+0.5, 0.5-lat/PI);\n  /* Sol fijo arriba-izquierda y algo por delante: da relieve y deja un terminador\n     suave que es lo que hace que se lea como ESFERA y no como disco. */\n  vec3 n=vec3(d.x,d.y,dz);\n  /* El sol va MUY oblicuo a propósito. Con la componente z alta (0.72) quedaba casi\n     de frente, todo el disco visible iluminado y la cara nocturna escondida por\n     detrás: las luces de ciudad no se veían nunca. Bajándola a 0.28 el terminador\n     cruza el disco y siempre hay un trozo de planeta de noche, encendido. */\n  vec3 sol=normalize(vec3(-0.62,0.44,0.28));\n  float cara=dot(n,sol);\n  float dif=max(cara,0.0);\n\n  vec3 dia=texture2D(uTex,uv).rgb*(0.42+0.72*dif);\n  /* La cara nocturna no es negra: son las luces de ciudad de verdad, medidas por el\n     VIIRS. Es lo que convierte el globo en un planeta habitado — se distingue Europa,\n     el este de EE.UU., el valle del Nilo, la costa japonesa. */\n  vec3 noche=texture2D(uNoche,uv).rgb*1.35;\n\n  /* El terminador se cruza con smoothstep y no con un corte: en la Tierra real el\n     amanecer no es una línea, es una franja de unos cientos de kilómetros. */\n  float t=smoothstep(-0.14,0.30,cara);\n  vec3 col=mix(noche,dia,t);\n\n  /* Nubes reales, desplazadas en longitud para que giren un poco más despacio que el\n     planeta. Se iluminan como el terreno y casi desaparecen de noche, igual que pasa\n     de verdad. */\n  float nub=texture2D(uNubes,vec2(uv.x+uNubOff,uv.y)).r;\n  col=mix(col,vec3(1.0,0.99,0.97)*(0.30+0.80*dif),nub*0.72*max(t,0.10));\n\n  /* Realce de borde: la atmósfera vista de canto. */\n  col+=pow(1.0-dz,3.0)*vec3(0.35,0.55,0.85)*0.42;\n  gl_FragColor=vec4(col,1.0);\n}","GLOBO_PAIS":{"CHI":[-70.7,-33.4],"ARG":[-58.4,-34.6],"URU":[-56.2,-34.9],"PAR":[-57.6,-25.3],"BRA":[-47.9,-15.8],"BOL":[-68.1,-16.5],"PER":[-77,-12],"ECU":[-78.5,-0.2],"COL":[-74.1,4.7],"VEN":[-66.9,10.5],"ESP":[-3.7,40.4],"ENG":[-0.1,51.5],"ITA":[12.5,41.9],"GER":[13.4,52.5],"FRA":[2.3,48.9],"JPN":[139.7,35.7],"KOR":[127,37.6],"KSA":[46.7,24.7],"EGY":[31.2,30],"MAR":[-6.8,34],"RSA":[28,-26.2],"AUS":[151.2,-33.9],"MEX":[-99.1,19.4],"USA":[-77,38.9]},"GLOBO_TIERRA":[["sam",[[-75,11],[-71,12],[-64,11],[-60,8],[-52,5],[-50,0],[-44,-2],[-38,-5],[-35,-8],[-39,-13],[-39,-18],[-48,-25],[-53,-34],[-58,-38],[-62,-41],[-65,-45],[-68,-52],[-75,-53],[-73,-45],[-73,-37],[-71,-30],[-70,-23],[-71,-18],[-77,-12],[-81,-6],[-80,-2],[-79,2],[-77,8]]],["nam",[[-168,66],[-160,71],[-140,70],[-125,70],[-110,68],[-95,68],[-80,70],[-64,60],[-56,50],[-66,45],[-70,42],[-75,36],[-81,26],[-90,29],[-97,26],[-105,20],[-97,16],[-92,15],[-87,13],[-83,8],[-79,9],[-85,15],[-92,18],[-97,22],[-110,24],[-114,32],[-122,37],[-124,48],[-133,55],[-150,59],[-165,55]]],["afr",[[-17,15],[-13,20],[-10,28],[-6,36],[3,37],[10,37],[20,32],[32,31],[35,24],[39,18],[43,12],[51,12],[47,3],[41,-2],[40,-9],[40,-15],[35,-24],[30,-31],[26,-34],[18,-34],[13,-23],[12,-17],[9,-1],[6,4],[3,6],[-4,5],[-8,5],[-13,9]]],["eur",[[-10,36],[-9,44],[-2,49],[2,51],[4,53],[8,55],[11,58],[5,62],[10,64],[15,68],[21,70],[28,71],[35,68],[40,68],[55,70],[70,73],[90,76],[110,74],[130,72],[145,70],[160,68],[170,65],[163,60],[155,57],[143,53],[135,45],[127,40],[122,32],[117,24],[108,20],[103,13],[98,8],[95,16],[90,22],[82,20],[80,10],[77,8],[72,20],[64,25],[57,24],[50,29],[48,38],[43,41],[36,36],[28,36],[24,40],[18,40],[15,38],[12,45],[6,43],[-2,43]]],["aus",[[113,-22],[114,-33],[118,-35],[128,-32],[137,-35],[146,-39],[150,-37],[153,-28],[146,-19],[142,-11],[135,-12],[130,-11],[125,-14],[121,-19]]],["gro",[[-45,60],[-52,66],[-55,71],[-45,78],[-30,82],[-20,78],[-22,70],[-40,63]]],["jpn",[[130,31],[135,34],[140,36],[142,42],[145,44],[141,45],[139,38],[136,35],[132,33]]],["gbr",[[-5,50],[-6,55],[-3,58],[-2,56],[0,53],[1,51]]],["nzl",[[173,-35],[178,-38],[174,-42],[170,-46],[167,-45],[172,-40]]],["mad",[[43,-12],[50,-15],[50,-25],[45,-25],[43,-19]]],["ind",[[95,-2],[105,-6],[115,-8],[125,-9],[135,-3],[130,1],[118,2],[105,2],[97,3]]],["ant",[[-180,-70],[-140,-73],[-100,-73],[-60,-70],[-20,-70],[20,-69],[60,-67],[100,-66],[140,-68],[180,-70],[180,-84],[-180,-84]]]],"GLOBO_VS":"\nattribute vec2 aPos;\nvarying vec2 vPos;\nvoid main(){ vPos=aPos; gl_Position=vec4(aPos,0.0,1.0); }","GLOSARIO":[["Media (OVR)","El nivel global del jugador, de 20 a 99. Sale de sus seis atributos ponderados según el puesto que ocupa."],["Proyección","El techo al que puede llegar. Solo lo ves de tus jugadores o de los que hayas ojeado a fondo."],["Aptitud","Lo bien que encaja un jugador en la posición donde lo pones. Fuera de su puesto natural rinde menos."],["Rol","La función concreta dentro del sistema (pivote, falso nueve…). Suma o resta según sus atributos."],["Forma","Su estado reciente. Sube con buenas actuaciones y baja con las malas."],["Físico","Cuánta gasolina le queda. Baja durante el partido y se recupera entrenando."],["Ansiedad","Su estado mental. Por encima de 70 empieza a rendir peor y puede pedir baja psicológica."],["Moral","Cómo se siente en el club. La mueven los resultados, tus charlas y las decisiones del camarín."],["Camarilla","Grupo interno del vestuario. Si dejas fuera al líder de un grupo, todo el grupo se resiente."],["xG","Goles esperados: cuánto deberías haber marcado según la calidad de tus ocasiones."],["Momentum","Quién domina el partido en este momento. No es posesión: es peligro real."],["Cláusula","Precio fijo al que cualquier club puede llevarse al jugador sin negociar."],["Precontrato","Acuerdo para fichar gratis a alguien que acaba contrato. Se firma desde la semana 24."],["Opción de compra","En una cesión, el club de destino puede comprarlo al final. Con obligación, tiene que hacerlo."],["Porcentaje de futura venta","Te quedas con una parte de lo que el club comprador gane si lo revende."],["Fair play financiero","Control de gasto: si gastas más de lo que ingresas, la federación aprieta."],["Licencia de club","Permiso anual para competir. Exige infraestructura y cuentas sanas."],["Funa","La presión de las redes sociales contra tu gestión. Alta, el directorio se pone nervioso."],["Reputación","Tu prestigio como entrenador. Abre puertas, mejora fichajes y sube tu sueldo."],["Regen","Jugador nuevo generado para reemplazar a los que se retiran. Algunos son hijos de leyendas."]],"HABS":{"ruleta":["Ruleta","Gira sobre sí mismo y deja rivales sentados"],"caño":["Caño","Le pasa la pelota entre las piernas a cualquiera"],"bicicleta":["Bicicleta","Amaga con las dos piernas a toda velocidad"],"sombrero":["Sombrero","Levanta la pelota por encima del rival"],"elastico":["Elástico","Cambio de dirección imposible con el empeine"],"rabona":["Rabona","Cruza la pierna y pega igual"],"chilena":["Chilena","Busca la acrobacia dentro del área"],"tiroLibre":["Tiro libre","Especialista desde la barrera"],"penalero":["Penalero","Frío desde los doce pasos"],"corner":["Córner","Deja la pelota donde quiere en el área"],"cabezazo":["Cabezazo","Gana todo por arriba"],"latigo":["Látigo","Zurdazo o derechazo de media distancia"],"pasePro":["Pase filtrado","Ve el pase que nadie ve"],"arranque":["Arranque","Los primeros cinco metros no se los gana nadie"],"liderazgo":["Voz de mando","Ordena a la línea sin necesidad de banda"],"atajaPen":["Ataja penales","Adivina el palo más veces de lo normal"],"juegoPies":["Juego de pies","Portero que sale jugando como un central"]},"HAB_CAMPO":["ruleta","caño","bicicleta","sombrero","elastico","rabona","chilena","tiroLibre","penalero","corner","cabezazo","latigo