## La silueta de un país como polígono listo para `Polygon2D`, escalada al
## tamaño pedido. Vacío si el país no tiene silueta: la pantalla lo dibuja
## entonces como un recuadro y no se rompe nada.
static func poligono(pais: String, tam: Vector2) -> PackedVector2Array:
	var salida := PackedVector2Array()
	if not SILUETAS.has(pais):
		return salida
	for p: Array in SILUETAS[pais]:
		salida.append(Vector2(float(p[0]) * tam.x, float(p[1]) * tam.y))
	return salida

static func hay(pais: String) -> bool:
	return SILUETAS.has(pais)
