## {"ruta:var": tamaño} de las que existen.
static func medir() -> Dictionary:
	var r := {}
	for par: Array in LISTA:
		var s: Variant = load(String(par[0])) if ResourceLoader.has_cached(String(par[0])) else null
		if s == null:
			continue
		var v: Variant = (s as Script).get(String(par[1]))
		if v is Dictionary or v is Array:
			r["%s:%s" % [String(par[0]).get_file(), par[1]]] = v.size()
	return r
