[configuration]

entry_symbol = "dinastia_nativo_iniciar"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin_nativo/libdinastia.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin_nativo/libdinastia.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin_nativo/libdinastia.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin_nativo/libdinastia.windows.template_release.x86_64.dll"
