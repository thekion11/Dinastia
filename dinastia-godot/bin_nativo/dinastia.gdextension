[configuration]

entry_symbol = "dinastia_nativo_iniciar"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin_nativo/libdinastia.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin_nativo/libdinastia.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin_nativo/libdinastia.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin_nativo/libdinastia.windows.template_release.x86_64.dll"
linux.debug.arm64 = "res://bin_nativo/libdinastia.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin_nativo/libdinastia.linux.template_release.arm64.so"
android.debug.arm64 = "res://bin_nativo/libdinastia.android.template_debug.arm64.so"
android.release.arm64 = "res://bin_nativo/libdinastia.android.template_release.arm64.so"
